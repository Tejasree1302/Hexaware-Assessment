--Create Snowpipe
--Create Pipe
CREATE OR REPLACE PIPE APPOINTMENT_PIPE
AUTO_INGEST = FALSE
AS
COPY INTO APPOINTMENT_RAW
FROM @APPOINTMENT_STAGE
FILE_FORMAT = (FORMAT_NAME = CSV_FORMAT)
ON_ERROR = 'CONTINUE';

ALTER PIPE APPOINTMENT_PIPE REFRESH;


SELECT COUNT(*) FROM APPOINTMENT_RAW;

--Create Reporting View
CREATE OR REPLACE VIEW VW_APPOINTMENT_DASHBOARD AS
SELECT
AGE_GROUP,
GENDER,
NEIGHBORHOOD,
ATTENDANCE_STATUS,
WAITING_DAYS,
SMS_RECEIVED,
COUNT(*) AS TOTAL_APPOINTMENTS,
SUM(
CASE
WHEN ATTENDANCE_STATUS = 'Missed'
THEN 1
ELSE 0
END
) AS MISSED_APPOINTMENTS
FROM APPOINTMENT_FINAL
GROUP BY
AGE_GROUP,
GENDER,
NEIGHBORHOOD,
ATTENDANCE_STATUS,
WAITING_DAYS,
SMS_RECEIVED;
