--Healthcare Appointment No-Show Analytics using Snowflake

USE ROLE ACCOUNTADMIN;

--Task 1 — Create Warehouse, Database, Schema
--Create Warehouse
CREATE OR REPLACE WAREHOUSE HEALTHCARE_WH
WITH
WAREHOUSE_SIZE = 'XSMALL'
AUTO_SUSPEND = 60
AUTO_RESUME = TRUE
INITIALLY_SUSPENDED = TRUE;


--Create Database
CREATE OR REPLACE DATABASE HEALTHCARE_DB;

--Create Schema
CREATE OR REPLACE SCHEMA HEALTHCARE_DB.APPOINTMENT_SCHEMA;

--Use Objects
USE WAREHOUSE HEALTHCARE_WH;

USE DATABASE HEALTHCARE_DB;

USE SCHEMA APPOINTMENT_SCHEMA;

--Create File Format
CREATE OR REPLACE FILE FORMAT CSV_FORMAT
TYPE = 'CSV'
SKIP_HEADER = 1
FIELD_OPTIONALLY_ENCLOSED_BY = '"'
NULL_IF = ('NULL', 'null')
EMPTY_FIELD_AS_NULL = TRUE;


--create INTERNAL STAGE
CREATE OR REPLACE STAGE APPOINTMENT_STAGE
FILE_FORMAT = CSV_FORMAT;

--Scale it up to SMALL
ALTER WAREHOUSE HEALTHCARE_WH
SET WAREHOUSE_SIZE = 'SMALL';

--Scale Down to XSMALL
ALTER WAREHOUSE HEALTHCARE_WH
SET WAREHOUSE_SIZE = 'XSMALL';

--Suspend Warehouse
ALTER WAREHOUSE HEALTHCARE_WH SUSPEND;

--Resume Warehouse
ALTER WAREHOUSE HEALTHCARE_WH RESUME;

SHOW WAREHOUSES;

--uploaded the csv file into snowflake stage using snowsight

--verifying upload
LIST @APPOINTMENT_STAGE;

--CREATE RAW TABLE
CREATE OR REPLACE TABLE APPOINTMENT_RAW
(
PATIENTID NUMBER,
APPOINTMENTID NUMBER,
GENDER STRING,
SCHEDULEDDAY STRING,
APPOINTMENTDAY STRING,
AGE NUMBER,
NEIGHBOURHOOD STRING,
SCHOLARSHIP NUMBER,
HIPERTENSION NUMBER,
DIABETES NUMBER,
ALCOHOLISM NUMBER,
HANDCAP NUMBER,
SMS_RECEIVED NUMBER,
NO_SHOW STRING
);


--LOAD DATA USING COPY INTO 
COPY INTO APPOINTMENT_RAW
FROM @APPOINTMENT_STAGE/appointment_no_show.csv
FILE_FORMAT = (FORMAT_NAME = CSV_FORMAT)
ON_ERROR = 'CONTINUE';

--VERIFY DATA
SELECT * FROM APPOINTMENT_RAW LIMIT 10;

--CREATING FINAL TABLE
CREATE OR REPLACE TABLE APPOINTMENT_FINAL
(
PATIENT_ID NUMBER,
APPOINTMENT_ID NUMBER,
GENDER STRING,
AGE NUMBER,
AGE_GROUP STRING,
SCHEDULED_DATE TIMESTAMP,
APPOINTMENT_DATE TIMESTAMP,
WAITING_DAYS NUMBER,
NEIGHBORHOOD STRING,
SCHOLARSHIP NUMBER,
HYPERTENSION NUMBER,
DIABETES NUMBER,
ALCOHOLISM NUMBER,
HANDICAP NUMBER,
SMS_RECEIVED NUMBER,
NO_SHOW_STATUS STRING,
ATTENDANCE_STATUS STRING
);


CREATE OR REPLACE PROCEDURE LOAD_APPOINTMENT_DATA()
RETURNS STRING
LANGUAGE PYTHON
RUNTIME_VERSION = '3.9'
PACKAGES = ('snowflake-snowpark-python')
HANDLER = 'run'
AS
$$
from snowflake.snowpark.functions import *
from snowflake.snowpark import Session

def run(session):

    df = session.table("APPOINTMENT_RAW")

    transformed_df = df.select(
        col("PATIENTID").alias("PATIENT_ID"),
        col("APPOINTMENTID").alias("APPOINTMENT_ID"),
        col("GENDER"),
        col("AGE"),

        when(col("AGE") <= 12, "Child")
        .when((col("AGE") >= 13) & (col("AGE") <= 19), "Teen")
        .when((col("AGE") >= 20) & (col("AGE") <= 39), "Adult")
        .when((col("AGE") >= 40) & (col("AGE") <= 59), "Middle Age")
        .otherwise("Senior Citizen")
        .alias("AGE_GROUP"),

        to_timestamp(col("SCHEDULEDDAY")).alias("SCHEDULED_DATE"),

        to_timestamp(col("APPOINTMENTDAY")).alias("APPOINTMENT_DATE"),

        datediff(
            "day",
            to_date(col("SCHEDULEDDAY")),
            to_date(col("APPOINTMENTDAY"))
        ).alias("WAITING_DAYS"),

        col("NEIGHBOURHOOD").alias("NEIGHBORHOOD"),

        col("SCHOLARSHIP"),
        col("HIPERTENSION").alias("HYPERTENSION"),
        col("DIABETES"),
        col("ALCOHOLISM"),

        col("HANDCAP").alias("HANDICAP"),

        col("SMS_RECEIVED"),

        col("NO_SHOW").alias("NO_SHOW_STATUS"),

        when(col("NO_SHOW") == "No", "Visited")
        .otherwise("Missed")
        .alias("ATTENDANCE_STATUS")

    )

    transformed_df.write.mode("overwrite").save_as_table("APPOINTMENT_FINAL")

    return "Data Loaded Successfully"
$$;

--Execute Procedure
CALL LOAD_APPOINTMENT_DATA();


SELECT * FROM APPOINTMENT_FINAL ;


