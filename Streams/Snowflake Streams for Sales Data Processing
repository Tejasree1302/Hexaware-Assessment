--Create Database
CREATE OR REPLACE TRANSIENT DATABASE STREAMS_DB;

--Use Database
USE DATABASE STREAMS_DB;

--Create Raw Sales Staging Table
CREATE OR REPLACE TABLE SALES_RAW_STAGING (
    id INT,
    product STRING,
    price FLOAT,
    amount INT,
    store_id INT
);

--Insert Initial Sales Data
INSERT INTO SALES_RAW_STAGING (id, product, price, amount, store_id)
VALUES
(1, 'Banana', 1.99, 1, 1),
(2, 'Lemon', 0.99, 1, 1),
(3, 'Apple', 1.79, 1, 2),
(4, 'Orange Juice', 1.89, 1, NULL),
(5, 'Cereals', 5.98, 2, 1);

--Create Store Table
CREATE OR REPLACE TABLE STORE_TABLE (
    store_id INT,
    location STRING,
    employees INT
);

--Insert Store Data
INSERT INTO STORE_TABLE (store_id, location, employees)
VALUES
(1, 'Chicago', 33),
(2, 'London', 12);

--Create Final Sales Table
CREATE OR REPLACE TABLE SALES_FINAL_TABLE (
    id INT,
    product STRING,
    price FLOAT,
    amount INT,
    store_id INT,
    location STRING,
    employees INT
);

--Perform Initial Full Load
INSERT INTO SALES_FINAL_TABLE
SELECT
    s.id,
    s.product,
    s.price,
    s.amount,
    s.store_id,
    st.location,
    st.employees
FROM SALES_RAW_STAGING s
LEFT JOIN STORE_TABLE st
ON s.store_id = st.store_id;

--Verify Initial Load
SELECT * FROM SALES_RAW_STAGING;

SELECT * FROM STORE_TABLE;

SELECT * FROM SALES_FINAL_TABLE;


--STREAM IMPLEMENTATION
CREATE OR REPLACE STREAM SALES_STREAM
ON TABLE SALES_RAW_STAGING;

SHOW STREAMS;

DESCRIBE STREAM SALES_STREAM;

SELECT * FROM SALES_STREAM;

--INSERT CHANGE CAPTURE
INSERT INTO SALES_RAW_STAGING (id, product, price, amount, store_id)
VALUES
(6, 'Mango', 1.99, 1, 2),
(7, 'Garlic', 0.99, 1, 1);

SELECT * FROM SALES_STREAM;

--Verify Source and Target Tables
SELECT * FROM SALES_RAW_STAGING;


SELECT * FROM SALES_FINAL_TABLE;

--Consume Stream Data
INSERT INTO SALES_FINAL_TABLE
SELECT
    s.id,
    s.product,
    s.price,
    s.amount,
    s.store_id,
    st.location,
    st.employees
FROM SALES_STREAM s
LEFT JOIN STORE_TABLE st
ON s.store_id = st.store_id
WHERE METADATA$ACTION = 'INSERT';


--Verify Stream After Consumption
SELECT * FROM SALES_STREAM;


--SECOND INSERT CHANGE CAPTURE
INSERT INTO SALES_RAW_STAGING (id, product, price, amount, store_id)
VALUES
(8, 'Paprika', 4.99, 1, 2),
(9, 'Tomato', 3.99, 1, 2);


--Consume Second Stream Data
INSERT INTO SALES_FINAL_TABLE
SELECT
    s.id,
    s.product,
    s.price,
    s.amount,
    s.store_id,
    st.location,
    st.employees
FROM SALES_STREAM s
LEFT JOIN STORE_TABLE st
ON s.store_id = st.store_id
WHERE METADATA$ACTION = 'INSERT';

--Verify Final Insert Output
SELECT * FROM SALES_FINAL_TABLE;

SELECT * FROM SALES_RAW_STAGING;


SELECT * FROM SALES_STREAM;


--UPDATE CHANGE CAPTURE
SELECT * FROM SALES_RAW_STAGING;


SELECT * FROM SALES_STREAM;


--Perform First Update
UPDATE SALES_RAW_STAGING
SET product = 'Potato'
WHERE product = 'Banana';


--Check Stream After Update
SELECT * FROM SALES_STREAM;


--Consume Update Using MERGE
MERGE INTO SALES_FINAL_TABLE tgt
USING (
    SELECT *
    FROM SALES_STREAM
    WHERE METADATA$ACTION = 'INSERT'
    AND METADATA$ISUPDATE = TRUE
) src
ON tgt.id = src.id

WHEN MATCHED THEN
UPDATE SET
    tgt.product = src.product,
    tgt.price = src.price,
    tgt.amount = src.amount,
    tgt.store_id = src.store_id;

SELECT * FROM SALES_FINAL_TABLE;


SELECT * FROM SALES_RAW_STAGING;

SELECT * FROM SALES_STREAM;


